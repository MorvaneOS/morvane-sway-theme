# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for Sway. Everything installed is generated by tools/build.py
# and committed, so building the package needs nothing but the repo.

pkgname=morvane-sway-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for Sway: window and bar colours and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-sway-theme'
license=(LGPL-2.1-or-later)
depends=(
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wm-theme    # foot, waybar and friends
  morvane-wallpapers
  swaybg
)
backup=(etc/sway/config.d/50-morvane-theme.conf)

package() {
  # Sway's default config includes /etc/sway/config.d/*
  install -Dm644 "$startdir"/config.d/50-morvane-theme.conf -t "$pkgdir/etc/sway/config.d/"
}
